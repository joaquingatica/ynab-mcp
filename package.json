{
  "name": "ynab-mcp",
  "version": "1.0.0",
  "description": "YNAB MCP Server",
  "author": "Joaquin Gatica <me@joaquingatica.com>",
  "license": "MIT",
  "homepage": "https://github.com/joaquingatica/ynab-mcp",
  "bugs": {
    "url": "https://github.com/joaquingatica/ynab-mcp/issues"
  },
  "keywords": [
    "ynab",
    "api",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaquingatica/ynab-mcp.git"
  },
  "type": "module",
  "main": "src/server.mts",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf bin build dist .tsbuildinfo",
    "start": "npm run build && node build/server.mjs",
    "build": "tsc -b tsconfig.build.json",
    "dxt:pack": "npm run build && ./pack.sh",
    "dxt:validate": "dxt validate manifest.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@effect/ai": "^0.21.14",
    "@effect/platform": "^0.87.10",
    "@effect/platform-node": "^0.89.2",
    "effect": "^3.16.12",
    "ynab": "^2.9.0"
  },
  "devDependencies": {
    "@anthropic-ai/dxt": "^0.2.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "^0.23.5",
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@tsconfig/node22": "^22.0.2",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
